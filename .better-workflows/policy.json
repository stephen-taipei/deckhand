{
  "version": 1,
  "completion": { "require": ["plugin-test", "script-test"] },
  "evidence": {
    "kinds": [
      {
        "kind": "plugin-test",
        "exact": true,
        "cwd": "plugins/deckhand",
        "argv": [
          ["python3", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"],
          ["python", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"]
        ]
      },
      {
        "kind": "script-test",
        "exact": true,
        "argv": [
          ["python3", "-m", "unittest", "discover", "-s", "scripts", "-p", "test_*.py"],
          ["python", "-m", "unittest", "discover", "-s", "scripts", "-p", "test_*.py"]
        ]
      },
      { "kind": "hook-test", "exact": true, "argv": [["claude", "plugin", "test", "plugins/deckhand"]] }
    ]
  },
  "actions": {
    "default": "ask",
    "rules": {
      "git-push": "allow",
      "gh-pr-create": "allow",
      "gh-pr-merge": "ask",
      "gh-release": "ask",
      "package-publish": "deny"
    }
  },
  "opaque": "ask"
}
